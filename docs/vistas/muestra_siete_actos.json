      "voz": {
        "clave": "cba68bf522d834a2d62ad180",
        "duracion": 8.856,
        "texto": "Para mí, la cultura debe ser la primera prioridad de la próxima alcaldía. Una ciudad también necesita lugares donde imaginarse.",
        "hablante": "ADRIAN"
      }
    },
    {
      "tipo": "narrador",
