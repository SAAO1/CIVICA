      "ambiente": "redaccion",
      "fotogramas": 240,
      "inicio": 95.625,
      "duracion": 10.0,
      "voz": {
        "clave": "19bb39167e993ec620c42c14",
        "duracion": 8.568,
        "texto": "La lluvia golpea la ventana de la redacción. Un audio termina demasiado pronto y deja a todos mirando el teléfono.",
        "hablante": "NARRADOR"
      }
    },
